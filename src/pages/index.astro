---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import { withBase } from "../utils";

const posts = (await getCollection("blog"))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.latest {
				list-style: none;
				margin: 0 0 2em;
				padding: 0;
			}
			.latest li {
				margin-bottom: 1em;
			}
			.latest .date {
				color: rgb(var(--gray));
				font-size: 0.9em;
				margin: 0;
			}
			.cta {
				display: flex;
				gap: 1em;
				flex-wrap: wrap;
			}
			.cta a {
				display: inline-block;
				padding: 0.5em 1.2em;
				border-radius: 8px;
				background: var(--accent);
				color: var(--bg);
				text-decoration: none;
				font-weight: 700;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Bienvenue sur {SITE_TITLE} !</h1>
			<p>
				Ce blog est consacré à <strong>Dominion</strong>, le jeu de
				deck-building de Donald X. Vaccarino. Vous pourrez y trouver mes
				diverses analyses stratégiques, conseils, avis et créations en
				rapport avec ce jeu.
			</p>
			<h3>Derniers articles</h3>
			<ul class="latest">
				{
					posts.map((post) => (
						<li>
							<a href={withBase(`/blog/${post.id}/`)}>
								{post.data.title}
							</a>
							<p class="date">
								<FormattedDate date={post.data.pubDate} />
							</p>
						</li>
					))
				}
			</ul>
			<div class="cta">
				<a href={withBase("/blog/")}>Tous les articles</a>
				<a href={withBase("/cartes/")}>Galerie des cartes</a>
			</div>
		</main>
		<Footer />
	</body>
</html>
